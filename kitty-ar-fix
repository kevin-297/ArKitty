# 6k: NFKC expands the salawat ligature into 4 words, so it cannot round-trip
SKIP_RT = {"6k"}


def roundtrip_check():
    print(f"\n{BOLD}== AUTOMATIC ROUND-TRIP CHECK (no eyes needed) =={OFF}")
    print(f"{DIM}unfix(fix(x)) must give back x (after NFKC, marks/tatweel/diacritics removed, "
          f"spaces collapsed){OFF}")
    if PUNCT_MODE == "space":
        print("skipped: PUNCT_MODE='space' cannot be undone")
        return
    bad = 0
    for _, cid, text, _ in CASES:
        if cid in SKIP_RT:
            continue
        got, want = norm(unfix(fix(text))), norm(text)
        if DIGITS_MODE == "ascii":
            want = want.translate(_TO_ASCII)
        if got != want:
            bad += 1
            print(f"FAIL {cid}\n     want {want!r}\n     got  {got!r}")
    total = len(CASES) - len(SKIP_RT)
    print(f"{total - bad}/{total} passed" + ("" if not bad else f"   ({bad} failed)"))


