def norm(text):
    """What unfix(fix(x)) should give back: NFKC, no diacritics/marks/tatweel, single spaces."""
    t = unicodedata.normalize("NFKC", text)
    t = "".join(c for c in t if unicodedata.category(c) != "Mn")
    t = _MARKS.sub("", t).replace("\u0640", "")
    return " ".join(t.split())


def visual_check(wanted):
    last = None
    for group, cid, text, expect in CASES:
        if wanted and group not in wanted:
            continue
        if group != last:
            print(f"\n{BOLD}== {group}. {GROUPS[group]} =={OFF}")
            last = group
        print(f"{cid}  {DIM}expect: {expect}{OFF}")
        print(f"    -{fix(text)}-" if not text.strip() else f"    {fix(text)}")
    if not wanted or 7 in wanted:
        print(f"7b  {DIM}expect: same text wrapped by us at 50 cols, each line right-aligned, "
              f"first line = start of the sentence{OFF}")
        long_text = " ".join(["السلام عليكم ورحمة الله وبركاته"] * 4)
        print("\n".join("    " + l for l in fix_wrapped(long_text, 50).split("\n")))


